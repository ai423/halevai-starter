# העתיקו את הקובץ הזה ל-.env.local לעבודה מקומית.
# ב-Vercel מגדירים את אותם משתנים תחת Settings > Environment Variables.
# סודות אף פעם לא נכנסים לקוד ולא לגיט.

# נדרש רק אם הכלי שלכם קורא ל-Claude בזמן ריצה (סיווג, סיכום, ניסוח).
# רוב הכלים הראשונים לא צריכים את זה: ה-AI היה בבנייה, לא בריצה.
ANTHROPIC_API_KEY=

# אופציונלי. ברירת המחדל נמצאת ב-lib/claude.ts
CLAUDE_MODEL=
